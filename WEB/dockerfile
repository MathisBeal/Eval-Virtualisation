FROM python:3.9-alpine

LABEL version="1.0"

## Set work dir
WORKDIR /app

## Update packages
RUN apk update

## Install python libs
COPY requirements.txt ./
RUN pip install -r requirements.txt

## Expose port
EXPOSE 5000

## Runnig app
COPY app.py ./
CMD [ "python", "app.py" ]

